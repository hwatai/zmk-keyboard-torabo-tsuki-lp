#define JP_ZKHK  GRAVE        // Zenkaku ↔ Hankaku ↔ Kanji (半角 ↔ 全角 ↔ 漢字)
#define JP_MINUS MINUS        // -
#define JP_CARET EQUAL        // ^
#define JP_YEN   INT3         // ¥
#define JP_AT    LBKT         // @
#define JP_LBKT  RBKT         // [
#define JP_EISU  CAPS         // Eisū (英数)
#define JP_SEMI  SEMI         // ;
#define JP_COLON SQT          // :
#define JP_RBKT  NUHS         // ]
#define JP_COMMA COMMA        // ,
#define JP_DOT   DOT          // .
#define JP_SLASH SLASH        // /
#define JP_BSLH  INT1         // (backslash)
#define JP_MHEN  INT5         // Muhenkan (無変換)
#define JP_HENK  INT4         // Henkan (変換)
#define JP_KANA  INT2         // Katakana ↔ Hiragana ↔ Rōmaji (カタカナ ↔ ひらがな ↔ ローマ字)
#define JP_EXCL  LS(N1)       // !
#define JP_DQT   LS(N2)       // "
#define JP_HASH  LS(N3)       // #
#define JP_DLLR  LS(N4)       // $
#define JP_PRCNT LS(N5)       // %
#define JP_AMPS  LS(N6)       // &
#define JP_SQT   LS(N7)       // '
#define JP_LPAR  LS(N8)       // (
#define JP_RPAR  LS(N9)       // )
#define JP_EQUAL LS(JP_MINUS) // =
#define JP_TILDE LS(JP_CARET) // ~
#define JP_PIPE  LS(JP_YEN)   // |
#define JP_GRAVE LS(JP_AT)    // `
#define JP_LBRC  LS(JP_LBKT)  // {
#define JP_CAPS  LS(JP_EISU)  // Caps Lock
#define JP_PLUS  LS(JP_SEMI)  // +
#define JP_ASTRK LS(JP_COLON) // *
#define JP_RBRC  LS(JP_RBKT)  // }
#define JP_LT    LS(JP_COMMA) // <
#define JP_RT    LS(JP_DOT)   // >
#define JP_QMARK LS(JP_SLASH) // ?
#define JP_UNDER LS(JP_BSLH)  // _

#define SC_UP    MOVE_Y(300)
#define SC_DOWN  MOVE_Y(-300)
#define SC_RIGHT MOVE_X(300)
#define SC_LEFT  MOVE_X(-300)
#define MULCR_UP LC(LA(LS(UP)))
#define MULCR_DN LC(LA(LS(DOWN)))
#define WIN_L    LG(LEFT)
#define WIN_R    LG(RIGHT)
#define LANG_JP  LANGUAGE_1
#define LANG_EN  LANGUAGE_2

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        // A + S = DOWN SCROLL
        down_scroll {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&msc MOVE_Y(-300)>;
        };

        // D + F = UP SCROLL
        up_scroll {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&msc MOVE_Y(300)>;
        };

        // J + K = L Click
        l_click {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp LCLK>;
        };

        // L + - = R Click
        r_click {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&mkp RCLK>;
        };

        // Bluetooth Clear (combo for layer 3)
        bt_clear {
            timeout-ms = <50>;
            key-positions = <24 23 22>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {bindings = <
&kp Q         &kp W         &kp E         &kp R          &kp T                                       &kp Y        &kp U          &kp I          &kp O          &kp P
&kp A         &kp S         &kp D         &kp F          &kp G                                       &kp H        &kp J          &kp K          &kp L          &kp JP_MINUS
&mt LSHFT Z   &kp X         &kp C         &kp V          &kp B         &kp ESC        &kp TAB        &kp N        &kp M          &kp JP_COMMA   &kp JP_DOT     &kp JP_SLASH
&kp LCTRL     &kp LWIN      &kp LALT      &lt 4 BSPC     &lt 4 SPACE   &lt 3 LANG_JP  &lt 2 LANG_EN  &lt 1 ENTER  &none          &none          &kp RCTRL      &kp RSHFT    >;}; function {bindings = <
                                                                                                                                                                            //
&kp F1        &kp F2        &kp F3        &kp F4         &kp F5                                      &trans       &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &trans
&kp F6        &kp F7        &kp F8        &kp F9         &kp F10                                     &trans       &kp LS(WIN_L)  &kp LS(WIN_R)  &kp LS(LG(S))  &trans
&kp F11       &kp F12       &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &trans         &trans         &trans       &kp WIN_L      &kp WIN_R      &trans         &trans
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans       >;}; number {bindings = <
                                                                                                                                                                            //
&kp JP_EXCL   &kp JP_DQT    &kp JP_HASH   &kp JP_DLLR    &kp JP_PRCNT                                &kp JP_AMPS  &kp JP_SQT     &kp JP_LPAR    &kp JP_RPAR    &trans
&kp N1        &kp N2        &kp N3        &kp N4         &kp N5                                      &kp N6       &kp N7         &kp N8         &kp N9         &kp N0
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans       >;}; symbol {bindings = <
                                                                                                                                                                            //
&trans        &trans        &trans        &trans         &trans                                      &trans       &kp JP_MINUS   &kp JP_CARET   &kp JP_YEN     &trans
&trans        &trans        &trans        &kp LSHFT      &trans                                      &trans       &trans         &kp JP_AT      &kp JP_LBKT    &trans
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &kp JP_SEMI    &kp JP_COLON   &kp JP_RBKT    &trans
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &kp JP_BSLH    &trans       >;}; mouse {bindings = <
                                                                                                                                                                            //
&trans        &trans        &mkp MCLK     &trans         &trans                                      &trans       &trans         &trans         &trans         &trans
&msc SC_LEFT  &msc SC_DOWN  &msc SC_UP    &msc SC_RIGHT  &trans                                      &trans       &mkp LCLK      &mkp RCLK      &mkp MB4       &mkp MB5
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans       >;}; hotkey {bindings = <
                                                                                                                                                                            //
&trans        &trans        &trans        &trans         &trans                                      &trans       &trans         &trans         &trans         &trans
&kp HOME      &kp PG_DN     &kp PG_UP     &kp END        &trans                                      &trans       &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &kp BSPC       &kp DEL        &kp MUL_DOWN   &kp MUL_UP
&trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans       &trans         &trans         &trans         &trans       >;};
    };
};
